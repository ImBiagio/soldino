# Un blocco per dominio. Le app dietro ricevono X-Forwarded-For/Proto/Host e
# si fidano solo di proxy su reti private (trusted_proxies nei loro Caddyfile).
# Il controllo "admin solo dalla LAN" resta nelle app, sul client_ip vero.
# Niente encode qui: comprimono gia' i Caddy delle app.
cinem.inoo.it {
	reverse_proxy cinemino-web:80 {
		# Stream HLS degli anime: i segmenti passano senza buffer.
		flush_interval -1
	}
}

sold.inoo.it {
	reverse_proxy soldino-web:80
}
