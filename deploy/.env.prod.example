# Modello del .env di produzione (~/soldino/.env sul server). I valori veri
# stanno nel vault, nota "Credenziali e accessi". Mai committare il .env.
DJANGO_SETTINGS_MODULE=config.settings.prod
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=sold.inoo.it,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://sold.inoo.it
FRONTEND_BASE_URL=https://sold.inoo.it

POSTGRES_DB=soldino
POSTGRES_USER=soldino
# openssl rand -hex 24
POSTGRES_PASSWORD=

REFRESH_COOKIE_SAMESITE=Lax
# SMTP di Brevo, lo stesso account di cinemino (dominio inoo.it autenticato).
# Login e SMTP key in Credenziali e accessi (vault di cinemino).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Soldino <messagg@inoo.it>

# cornhub: login unico e AI (ADR 0021). Valori da `manage.py register_app
# soldino --name Soldino --url https://sold.inoo.it` sul server di cornhub.
CORNHUB_URL=https://cornhub.it
CORNHUB_INTERNAL_URL=http://cornhub-backend:8000
CORNHUB_APP_SLUG=soldino
CORNHUB_CLIENT_ID=
CORNHUB_CLIENT_SECRET=
CORNHUB_APP_TOKEN=

# Open banking (ADR 0013): cifra le chiavi Enable Banking degli utenti.
# Obbligatoria: senza, config.settings.prod non parte.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANKING_ENCRYPTION_KEY=

# GlitchTip (error.inoo.it, compatibile Sentry): backend, worker e beat. DSN in
# Credenziali e accessi. Vuoto = spenta, non parte nulla. Il frontend ha la
# sua DSN nella variabile del repo SENTRY_DSN_FRONTEND su GitHub.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

GUNICORN_WORKERS=3
LOG_LEVEL=INFO
