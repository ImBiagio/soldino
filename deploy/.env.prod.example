# Modello del .env di produzione (~/soldino/.env sul server). I valori veri
# stanno nel vault, nota "Credenziali e accessi". Mai committare il .env.
DJANGO_SETTINGS_MODULE=config.settings.prod
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=sold.inoo.it,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://sold.inoo.it
FRONTEND_BASE_URL=https://sold.inoo.it

POSTGRES_DB=soldino
POSTGRES_USER=soldino
# openssl rand -hex 24
POSTGRES_PASSWORD=

REFRESH_COOKIE_SAMESITE=Lax
# Niente SMTP per ora: con 1 la registrazione resterebbe bloccata sulla mail.
REQUIRE_EMAIL_VERIFICATION=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

GUNICORN_WORKERS=3
LOG_LEVEL=INFO
