# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Database ---
POSTGRES_DB=soldino
POSTGRES_USER=soldino
POSTGRES_PASSWORD=soldino
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth ---
# Vita dei token JWT (secondi)
ACCESS_TOKEN_LIFETIME=900
REFRESH_TOKEN_LIFETIME=1209600
# In dev il cookie di refresh non e' Secure (niente https su localhost)
REFRESH_COOKIE_SECURE=0
REFRESH_COOKIE_SAMESITE=Lax
# Verifica email obbligatoria alla registrazione
REQUIRE_EMAIL_VERIFICATION=0

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@soldino.local

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Scan estratto conto: chiave di un progetto Google AI Studio / Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
