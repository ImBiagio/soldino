#: apps/accounts/serializers.py:99 apps/recurring/serializers.py:51
#: apps/transactions/serializers.py:112
msgid "Chi paga deve essere un membro attivo del tracker."
msgstr "Whoever pays must be an active member of the tracker."

#: apps/accounts/views.py:51
msgid "Questo elemento e' gia' stato chiuso."
msgstr "This item has already been closed."

#: apps/banking/serializers.py:29
msgid "Il file e' troppo grande per essere una chiave."
msgstr "The file is too large to be a key."

#: apps/banking/serializers.py:99 apps/ingestion/serializers.py:168
#: apps/transactions/models.py:124
msgid "Il conto appartiene a un altro tracker."
msgstr "The account belongs to another tracker."

#: apps/banking/serializers.py:102
msgid "Puoi abbinare solo un conto intestato a te."
msgstr "You can only link an account in your name."

#: apps/banking/serializers.py:112
msgid "Questo conto e' gia' abbinato a un altro conto in banca."
msgstr "This account is already linked to another bank account."

#: apps/banking/services/crypto.py:34
msgid ""
"Il file non e' una chiave privata PEM valida (serve il .pem scaricato da "
"Enable Banking, senza password)."
msgstr ""
"The file isn't a valid PEM private key (you need the .pem downloaded from "
"Enable Banking, without a password)."

#: apps/banking/services/crypto.py:40
msgid "La chiave deve essere RSA, come quella generata da Enable Banking."
msgstr "The key must be RSA, like the one generated by Enable Banking."

#: apps/banking/services/crypto.py:59
msgid ""
"La chiave salvata non si decifra piu' (e' cambiata BANKING_ENCRYPTION_KEY): "
"ricarica il file .pem."
msgstr ""
"The saved key can no longer be decrypted (BANKING_ENCRYPTION_KEY has "
"changed): upload the .pem file again."

#: apps/banking/services/enablebanking.py:43
msgid ""
"Enable Banking ha rifiutato la firma: controlla che application ID e "
"file .pem siano della stessa applicazione."
msgstr ""
"Enable Banking rejected the signature: check that the application ID and "
"the .pem file belong to the same application."

#: apps/banking/services/enablebanking.py:51
msgid ""
"Enable Banking non conosce questo application ID: controlla che sia quello "
"dell'applicazione (e' il nome del file .pem)."
msgstr ""
"Enable Banking doesn't recognise this application ID: check that it's the "
"application's ID (it's the name of the .pem file)."

#: apps/banking/services/enablebanking.py:58
msgid "Il consenso della banca non e' piu' valido: rinnova il collegamento."
msgstr "The bank consent is no longer valid: renew the connection."

#: apps/banking/services/enablebanking.py:64
msgid "La banca ha raggiunto il limite di accessi giornalieri: riprova domani."
msgstr "The bank has reached its daily access limit: try again tomorrow."

#: apps/banking/services/enablebanking.py:68
#, python-format
msgid "Enable Banking ha risposto con un errore (%(code)s): %(detail)s"
msgstr "Enable Banking responded with an error (%(code)s): %(detail)s"

#: apps/banking/services/enablebanking.py:101
#, python-format
msgid "Enable Banking non risponde: %(error)s"
msgstr "Enable Banking isn't responding: %(error)s"

#: apps/banking/services/sync.py:50
msgid "Prima configura la tua applicazione Enable Banking."
msgstr "Set up your Enable Banking application first."

#: apps/banking/services/sync.py:65
#, python-format
msgid ""
"L'applicazione non ha %(url)s tra gli URL di ritorno (Redirect URLs): "
"aggiungilo nel pannello di Enable Banking e riprova."
msgstr ""
"The application doesn't have %(url)s among its return URLs (Redirect URLs): "
"add it in the Enable Banking dashboard and try again."

#: apps/banking/services/sync.py:136
msgid "Collegamento non trovato: riparti dalla sezione Banca."
msgstr "Connection not found: start again from the Bank section."

#: apps/banking/services/sync.py:320
msgid "non abbinato"
msgstr "not linked"

#: apps/banking/services/sync.py:324
msgid "Il consenso della banca e' scaduto: rinnova il collegamento."
msgstr "The bank consent has expired: renew the connection."

#: apps/banking/services/sync.py:330
msgid "consenso scaduto"
msgstr "consent expired"

#: apps/banking/views.py:222
msgid "Abbina prima il conto a un conto di Soldino."
msgstr "Link the account to a Soldino account first."

#: apps/core/methods.py:91 apps/transactions/models.py:120
msgid "L'importo deve essere positivo."
msgstr "The amount must be positive."

#: apps/core/methods.py:97
msgid "La data iniziale e' dopo quella finale."
msgstr "The start date is after the end date."

#: apps/core/permissions.py:18
msgid "Non hai i permessi su questo tracker."
msgstr "You don't have permission on this tracker."

#: apps/core/permissions.py:42
msgid "Solo il proprietario del tracker puo' eseguire questa azione."
msgstr "Only the tracker owner can do this."

#: apps/core/scoping.py:56
msgid "Tracker non accessibile."
msgstr "Tracker not accessible."

#: apps/ingestion/serializers.py:49
msgid "Categoria di un altro tracker."
msgstr "Category from another tracker."

#: apps/ingestion/serializers.py:52
msgid "La categoria e' di tipo diverso dal movimento."
msgstr "The category's type doesn't match the transaction."

#: apps/ingestion/serializers.py:56
msgid "Deve essere un membro del tracker."
msgstr "Must be a member of the tracker."

#: apps/ingestion/serializers.py:62
msgid "Il pareggio va a un altro membro del tracker."
msgstr "The settlement goes to another member of the tracker."

#: apps/ingestion/serializers.py:66
msgid "Chi da' e chi riceve devono essere diversi."
msgstr "The payer and the recipient must be different."

#: apps/ingestion/serializers.py:150
msgid "Il file e' troppo grande (max 15 MB)."
msgstr "The file is too large (max 15 MB)."

#: apps/ingestion/serializers.py:157
msgid "Serve una foto (JPEG, PNG, WebP o HEIC)."
msgstr "A photo is required (JPEG, PNG, WebP or HEIC)."

#: apps/ingestion/serializers.py:162
msgid "Serve un file PDF."
msgstr "A PDF file is required."

#: apps/ingestion/services/gemini.py:41
msgid "Gemini ha rifiutato la chiave: controlla GEMINI_API_KEY."
msgstr "Gemini rejected the key: check GEMINI_API_KEY."

#: apps/ingestion/services/gemini.py:42
#, python-format
msgid "Gemini ha risposto con un errore (%(code)s): %(message)s"
msgstr "Gemini responded with an error (%(code)s): %(message)s"

#: apps/ingestion/services/gemini.py:211
msgid ""
"Chiave Gemini non configurata: imposta GEMINI_API_KEY nel file .env e "
"riavvia."
msgstr ""
"Gemini key not configured: set GEMINI_API_KEY in the .env file and restart."

#: apps/ingestion/services/gemini.py:245
#, python-format
msgid "errore %(code)s"
msgstr "error %(code)s"

#: apps/ingestion/services/gemini.py:263
#, python-format
msgid ""
"Gemini e' sovraccarico in questo momento: nessun modello ha risposto "
"(%(models)s; ultimo: %(error)s). Riprova tra qualche minuto."
msgstr ""
"Gemini is overloaded right now: no model responded (%(models)s; last: "
"%(error)s). Try again in a few minutes."

#: apps/ingestion/services/gemini.py:277
msgid "La risposta di Gemini non e' nel formato atteso."
msgstr "Gemini's response isn't in the expected format."

#: apps/ingestion/services/gemini.py:309
msgid ""
"Non riesco a leggere il totale: rifai la foto con lo scontrino intero, "
"dritto e ben illuminato."
msgstr ""
"I can't read the total: retake the photo with the whole receipt, straight "
"and well lit."

#: apps/ingestion/services/gemini.py:354
msgid ""
"Non ho trovato nessun importo in quello che hai detto: riprova dicendo "
"quanto, per cosa e chi ha pagato."
msgstr ""
"I couldn't find any amount in what you said: try again saying how much, what "
"for and who paid."

#: apps/ingestion/services/scan.py:273
msgid "Errore imprevisto nella lettura."
msgstr "Unexpected error while reading."

#: apps/ingestion/views.py:116
msgid "Questo estratto conto non e' in revisione."
msgstr "This bank statement isn't under review."

#: apps/ingestion/views.py:163
msgid "Non ci sono righe da registrare."
msgstr "There are no lines to record."

#: apps/ingestion/views.py:175
msgid "Nessuna foto per questo import."
msgstr "No photo for this import."

#: apps/ingestion/views.py:198
msgid "Niente da rileggere."
msgstr "Nothing to re-read."

#: apps/recurring/models.py:68
msgid "Serve una rrule per la frequenza personalizzata."
msgstr "A custom frequency needs an rrule."

#: apps/recurring/models.py:82
msgid "La rrule non produce occorrenze successive."
msgstr "The rrule doesn't produce any further occurrences."

#: apps/recurring/serializers.py:57
msgid "Appartiene a un altro tracker."
msgstr "Belongs to another tracker."

#: apps/recurring/serializers.py:77
msgid "Formato non valido: [{user, share_pct}]."
msgstr "Invalid format: [{user, share_pct}]."

#: apps/recurring/views.py:34
msgid "Questa occorrenza e' gia' stata gestita."
msgstr "This occurrence has already been handled."

#: apps/trackers/invites.py:32
#, python-format
msgid "%(inviter)s ti ha invitato su Soldino"
msgstr "%(inviter)s invited you to Soldino"

#: apps/trackers/invites.py:35
#, python-format
msgid ""
"%(inviter)s ti ha invitato nel tracker \"%(tracker)s\" su Soldino, per "
"tenere insieme i conti delle spese condivise."
msgstr ""
"%(inviter)s invited you to the tracker \"%(tracker)s\" on Soldino, to keep "
"track of shared expenses together."

#: apps/trackers/invites.py:39
msgid "Apri l'invito"
msgstr "Open the invite"

#: apps/trackers/invites.py:42
msgid ""
"Se non hai ancora un account, crealo con questo stesso indirizzo email. "
"L'invito vale 30 giorni."
msgstr ""
"If you don't have an account yet, create one with this same email address. "
"The invite is valid for 30 days."

#: apps/trackers/methods.py:34
msgid "Deve essere un membro attivo del tracker."
msgstr "Must be an active member of the tracker."

#: apps/trackers/serializers.py:42
msgid "Il proprietario non si assegna."
msgstr "The owner role can't be assigned."

#: apps/trackers/serializers.py:98
msgid "Spesa alimentare, discount, alimentari"
msgstr "Groceries, discount stores, food shopping"

#: apps/trackers/serializers.py:101
msgid "Casa: affitto, mutuo, utenze, manutenzione, arredamento"
msgstr "Home: rent, mortgage, utilities, maintenance, furniture"

#: apps/trackers/serializers.py:104
msgid "Carburante, mezzi pubblici, treni, pedaggi, manutenzione auto"
msgstr "Fuel, public transport, trains, tolls, car maintenance"

#: apps/trackers/serializers.py:107
msgid "Ristoranti, bar, caffe', asporto, delivery"
msgstr "Restaurants, bars, coffee, takeaway, delivery"

#: apps/trackers/serializers.py:110
msgid "Farmacia, visite mediche, esami, dentista"
msgstr "Pharmacy, doctor visits, tests, dentist"

#: apps/trackers/serializers.py:113
msgid "Abbigliamento, elettronica, oggetti per la persona"
msgstr "Clothing, electronics, personal items"

#: apps/trackers/serializers.py:116
msgid "Abbonamenti ricorrenti: streaming, cloud, software"
msgstr "Recurring subscriptions: streaming, cloud, software"

#: apps/trackers/serializers.py:119
msgid "Cinema, viaggi, eventi, sport, hobby"
msgstr "Cinema, travel, events, sport, hobbies"

#: apps/trackers/serializers.py:121
msgid "Regali e donazioni"
msgstr "Gifts and donations"

#: apps/trackers/serializers.py:123
msgid "Tutto cio' che non rientra altrove"
msgstr "Anything that doesn't fit elsewhere"

#: apps/trackers/serializers.py:125
msgid "Stipendio e compensi da lavoro"
msgstr "Salary and work income"

#: apps/trackers/serializers.py:126
msgid "Rimborsi e storni"
msgstr "Refunds and reversals"

#: apps/trackers/serializers.py:127
msgid "Altre entrate"
msgstr "Other income"

#: apps/trackers/serializers.py:196
msgid "Categoria non valida."
msgstr "Invalid category."

#: apps/trackers/serializers.py:211
msgid "Al massimo tre anni per volta."
msgstr "At most three years at a time."

#: apps/trackers/views.py:53
msgid "Solo il proprietario puo' modificare il tracker."
msgstr "Only the owner can edit the tracker."

#: apps/trackers/views.py:65
msgid "Solo il proprietario puo' eliminare il tracker."
msgstr "Only the owner can delete the tracker."

#: apps/trackers/views.py:74
msgid "Solo il proprietario puo' archiviare il tracker."
msgstr "Only the owner can archive the tracker."

#: apps/trackers/views.py:83
msgid "Solo il proprietario puo' ripristinare il tracker."
msgstr "Only the owner can restore the tracker."

#: apps/trackers/views.py:105
msgid "Questa persona e' gia' invitata o gia' membro."
msgstr "This person has already been invited or is already a member."

#: apps/trackers/views.py:237
msgid "Solo il proprietario modifica i membri."
msgstr "Only the owner can edit members."

#: apps/trackers/views.py:245
msgid "Il proprietario non puo' declassare se stesso."
msgstr "The owner can't demote themselves."

#: apps/trackers/views.py:253
msgid "Solo il proprietario rimuove i membri."
msgstr "Only the owner can remove members."

#: apps/trackers/views.py:257
msgid "Il proprietario non si puo' rimuovere."
msgstr "The owner can't be removed."

#: apps/trackers/views.py:282 apps/trackers/views.py:324
msgid "Invito non valido o scaduto."
msgstr "Invalid or expired invite."

#: apps/trackers/views.py:287
msgid "Invito non piu' disponibile."
msgstr "Invite no longer available."

#: apps/trackers/views.py:294
msgid "L'invito e' intestato a un altro utente."
msgstr "The invite is for another user."

#: apps/trackers/views.py:300
msgid "L'invito e' stato inviato a un altro indirizzo email."
msgstr "The invite was sent to a different email address."

#: apps/transactions/models.py:109 apps/transactions/services/splits.py:68
#, python-format
msgid ""
"La somma delle quote (%(total)s) non coincide con l'importo (%(amount)s)."
msgstr ""
"The sum of the shares (%(total)s) doesn't match the amount (%(amount)s)."

#: apps/transactions/models.py:122
msgid "La categoria appartiene a un altro tracker."
msgstr "The category belongs to another tracker."

#: apps/transactions/models.py:127
msgid "Categoria di tipo diverso dalla transazione."
msgstr "Category type doesn't match the transaction."

#: apps/transactions/serializers.py:206
msgid "Il pareggio richiede due utenti diversi."
msgstr "A settlement needs two different users."

#: apps/transactions/serializers.py:209
msgid "Entrambi gli utenti devono essere membri attivi."
msgstr "Both users must be active members."

#: apps/transactions/services/reports.py:200
msgid "Senza categoria"
msgstr "Uncategorised"

#: apps/transactions/services/splits.py:49
msgid "Serve almeno una quota."
msgstr "At least one share is required."

#: apps/transactions/services/splits.py:53
msgid "Un utente non puo' comparire due volte."
msgstr "A user can't appear twice."

#: apps/transactions/services/splits.py:61
msgid "Le quote non possono essere negative."
msgstr "Shares can't be negative."

#: apps/transactions/services/splits.py:79
msgid "Le percentuali non possono essere negative."
msgstr "Percentages can't be negative."

#: apps/transactions/services/splits.py:81
msgid "Almeno una percentuale deve essere positiva."
msgstr "At least one percentage must be positive."

#: apps/transactions/services/splits.py:89
msgid "Usa o solo percentuali o solo importi esatti, non entrambi."
msgstr "Use either only percentages or only exact amounts, not both."

#: apps/transactions/services/splits.py:127
msgid "Una delle quote e' assegnata a un non membro del tracker."
msgstr ""
"One of the shares is assigned to someone who isn't a member of the tracker."

#: apps/users/emails.py:21
msgid "Conferma il tuo indirizzo email"
msgstr "Confirm your email address"

#: apps/users/emails.py:24
msgid ""
"Manca un passo: conferma che questo indirizzo e' tuo e il tuo account "
"Soldino e' pronto."
msgstr ""
"Just one more step: confirm this address is yours and your Soldino account "
"is ready."

#: apps/users/emails.py:27
msgid "Conferma email"
msgstr "Confirm email"

#: apps/users/emails.py:30
msgid ""
"Il link vale 3 giorni e una volta sola. Se non ti sei registrato tu, ignora "
"questa mail."
msgstr ""
"The link is valid for 3 days and can be used once. If you didn't sign up, "
"just ignore this email."

#: apps/users/emails.py:40
msgid "Reimposta la password di Soldino"
msgstr "Reset your Soldino password"

#: apps/users/emails.py:43
msgid ""
"Qualcuno (speriamo tu) ha chiesto di reimpostare la password del tuo account "
"Soldino."
msgstr ""
"Someone (hopefully you) asked to reset the password for your Soldino account."

#: apps/users/emails.py:46
msgid "Scegli una nuova password"
msgstr "Choose a new password"

#: apps/users/emails.py:49
msgid ""
"Il link vale 2 ore e una volta sola. Se non l'hai chiesto tu, ignora questa "
"mail: la password resta quella di prima."
msgstr ""
"The link is valid for 2 hours and can be used once. If you didn't request "
"it, just ignore this email: your password stays the same."

#: apps/users/serializers.py:38
msgid "Deve essere una lista di sezioni."
msgstr "Must be a list of sections."

#: apps/users/serializers.py:40
msgid "Sezione non valida."
msgstr "Invalid section."

#: apps/users/serializers.py:42
msgid "Sezione ripetuta."
msgstr "Duplicate section."

#: apps/users/serializers.py:63
msgid "Esiste gia' un account con questa email."
msgstr "An account with this email already exists."

#: apps/users/views.py:74
msgid "Registrazione completata. Controlla la mail per confermare."
msgstr "Sign-up complete. Check your email to confirm."

#: apps/users/views.py:100
msgid "Credenziali non valide."
msgstr "Invalid credentials."

#: apps/users/views.py:105
msgid "Email non ancora confermata."
msgstr "Email not confirmed yet."

#: apps/users/views.py:121
msgid "Refresh token assente."
msgstr "Refresh token missing."

#: apps/users/views.py:127
msgid "Refresh token non valido."
msgstr "Invalid refresh token."

#: apps/users/views.py:133
msgid "Utente non valido."
msgstr "Invalid user."

#: apps/users/views.py:170
msgid "Link non valido o scaduto."
msgstr "Invalid or expired link."

#: apps/users/views.py:175
msgid "Utente inesistente."
msgstr "User doesn't exist."

#: apps/users/views.py:180
msgid "Email gia' confermata: accedi con la tua password."
msgstr "Email already confirmed: sign in with your password."

#: apps/users/views.py:212
msgid "Password attuale errata."
msgstr "Current password is incorrect."

#: apps/users/views.py:274
msgid "Link non valido, gia' usato o scaduto: chiedine uno nuovo."
msgstr "Invalid, already used or expired link: request a new one."

#: templates/emails/base.html:25 templates/emails/base.txt:1
#, python-format
msgid "Ciao %(name)s,"
msgstr "Hi %(name)s,"

